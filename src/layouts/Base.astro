---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogLocale = lang === 'es' ? 'es_NI' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // El tema se fija antes de pintar: si no, la pagina parpadea.
      document.documentElement.classList.add('js');
      let theme = 'dark';
      try {
        const saved = localStorage.getItem('tema');
        theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      } catch {
        theme = 'dark';
      }
      document.documentElement.dataset.theme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'light' ? '#ffffff' : '#0b0c10');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={Astro.site ? new URL('/', Astro.site).href : '/'} />
    <link rel="alternate" hreflang="en" href={Astro.site ? new URL('/en/', Astro.site).href : '/en/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--ink)]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-[var(--route)] focus:px-3 focus:py-2 focus:text-[var(--bg)] focus:no-underline"
      >{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a
    >
    <slot />
  </body>
</html>

<script>
  // Entrada de los bloques al entrar en pantalla. Sin JS el contenido
  // se muestra tal cual: la clase .js decide si hay animacion.
  const targets = document.querySelectorAll('.reveal');

  if (targets.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
