---
import Page from '../../layouts/Page.astro';
import Hero from '../../components/Hero.astro';
import RouteMap from '../../components/RouteMap.astro';
import Superpowers from '../../components/Superpowers.astro';
import Workshop from '../../components/Workshop.astro';
import CommunityEducation from '../../components/CommunityEducation.astro';
import Contact from '../../components/Contact.astro';
import { ui_for } from '../../i18n/ui';

const t = ui_for('en');
---

<Page lang="en" title={t['site.title']} description={t['site.description']}>
  <Hero lang="en" />

  <RouteMap lang="en" />

  <Superpowers lang="en" />

  <section id="taller" class="mt-[var(--space-xl)]" aria-labelledby="taller-title">
    <h2 id="taller-title" class="text-3xl font-bold">The workshop</h2>
    <p class="mt-2 max-w-prose text-[var(--ink-soft)]">
      A product in incubation, an ERP that is not public yet, open-source libraries and research
      pieces. Every project says what is real and what is not: the ones without a client are
      presented as exactly that.
    </p>
    <Workshop lang="en" />
  </section>

  <CommunityEducation lang="en" />
  <Contact lang="en" />
</Page>
