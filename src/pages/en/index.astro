---
import Page from '../../layouts/Page.astro';
import Hero from '../../components/Hero.astro';
import RouteMap from '../../components/RouteMap.astro';
import Workshop from '../../components/Workshop.astro';
import CommunityEducation from '../../components/CommunityEducation.astro';
import Cajuela from '../../components/Cajuela.astro';
import { ui_for } from '../../i18n/ui';

const t = ui_for('en');
---

<Page lang="en" title={t['site.title']} description={t['site.description']}>
  <Hero lang="en" />

  <RouteMap lang="en" />

  <section id="taller" class="mt-[var(--space-xl)]" aria-labelledby="taller-title">
    <h2 id="taller-title" class="text-3xl font-bold">The workshop</h2>
    <Workshop lang="en" />
  </section>

  <CommunityEducation lang="en" />
  <Cajuela lang="en" />
</Page>
