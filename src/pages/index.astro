---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import RouteMap from '../components/RouteMap.astro';
import Workshop from '../components/Workshop.astro';
import CommunityEducation from '../components/CommunityEducation.astro';
import Cajuela from '../components/Cajuela.astro';
import { ui_for } from '../i18n/ui';

const t = ui_for('es');
---

<Page lang="es" title={t['site.title']} description={t['site.description']}>
  <Hero lang="es" />

  <RouteMap lang="es" />

  <section id="taller" class="mt-[var(--space-xl)]" aria-labelledby="taller-title">
    <h2 id="taller-title" class="text-3xl font-bold">El taller</h2>
    <Workshop lang="es" />
  </section>

  <CommunityEducation lang="es" />
  <Cajuela lang="es" />
</Page>
