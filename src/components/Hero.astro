---
import { existsSync } from 'node:fs';
import path from 'node:path';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const portraitCandidates = ['portrait.webp', 'portrait.jpg', 'portrait.png'];
const portraitFile = portraitCandidates.find((name) =>
  existsSync(path.resolve(process.cwd(), 'public/assets', name))
);
const portraitSrc = portraitFile ? `/assets/${portraitFile}` : '/assets/placeholders/portrait.svg';
const portraitAlt = portraitFile
  ? es
    ? 'Retrato de Andrés Sánchez'
    : 'Portrait of Andrés Sánchez'
  : es
    ? 'Retrato de Andrés (pendiente)'
    : 'Portrait of Andrés (pending)';
---

<section
  id="hero"
  class="mx-auto grid max-w-5xl gap-10 px-4 py-[var(--space-l)] md:grid-cols-[1.8fr_1fr] md:items-center"
>
  <div>
    <h1 class="text-[clamp(2.25rem,5vw,3rem)] font-extrabold leading-[1.06]">
      {es
        ? 'Brego sistemas modernos y comunidades que aprenden.'
        : 'I build modern systems and communities that learn.'}
    </h1>
    <p class="mt-5 max-w-prose text-lg">
      {
        es ? (
          <>
            Soy <strong class="font-semibold">Andrés Sánchez</strong>, desarrollador full-stack.
            Mi base está en León, Nicaragua, y trabajo con equipos de Managua y con clientes fuera
            del país: el contexto cambia, la ingeniería no. Estudio Ingeniería en Cibernética
            Electrónica en ULSA.{' '}
            <strong class="font-semibold text-[var(--route-hi)]">Go</strong> y{' '}
            <strong class="font-semibold text-[var(--route-hi)]">Astro</strong> son mis
            herramientas diarias; <strong class="font-semibold">Docker</strong> y un VPS con{' '}
            <strong class="font-semibold">nginx</strong> desplegado por{' '}
            <strong class="font-semibold">GitHub Actions</strong> son la base con la que trabajo.
            Diseño arquitectura y me fijo en el detalle de la interfaz.
          </>
        ) : (
          <>
            I’m <strong class="font-semibold">Andrés Sánchez</strong>, a full-stack developer. I’m
            based in León, Nicaragua, and I work with teams in Managua and with clients abroad: the
            context changes, the engineering doesn’t. I study Cybernetic Electronic Engineering at
            ULSA.{' '}
            <strong class="font-semibold text-[var(--route-hi)]">Go</strong> and{' '}
            <strong class="font-semibold text-[var(--route-hi)]">Astro</strong> are my daily
            tools; <strong class="font-semibold">Docker</strong> and a VPS behind{' '}
            <strong class="font-semibold">nginx</strong>, shipped by{' '}
            <strong class="font-semibold">GitHub Actions</strong>, are the baseline I work with. I
            design architecture and care about interface details.
          </>
        )
      }
    </p>
    <p class="mt-3 max-w-prose text-sm text-[var(--ink-soft)]">
      {
        es
          ? 'Escribo sobre backend y arquitectura; guío estudiantes universitarios como mentor en Boreal Labs y en mi propio Programming Club.'
          : 'I write about backend and architecture; I guide university students as a mentor at Boreal Labs and in my own Programming Club.'
      }
    </p>

    <p class="mt-7 inline-flex items-center gap-2 rounded-full border border-[var(--outline-variant)] bg-[var(--elev-1)] px-3 py-1 font-[var(--font-mono)] text-[12px] text-[var(--ink-soft)]">
      <span class="h-2 w-2 rounded-full bg-[var(--jungle)]" aria-hidden="true"></span>
      {es ? 'Disponible para freelance y trabajo remoto' : 'Available for freelance and remote work'}
    </p>

    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="mailto:a3235633@gmail.com"
        aria-label={es ? 'Enviar un correo a Andrés' : 'Email Andrés'}
        class="rounded-[var(--radius-s)] bg-[var(--route)] px-4 py-2 font-semibold text-[var(--bg)] no-underline transition-colors duration-[var(--dur-short)] ease-[var(--ease-emphasized)] hover:bg-[var(--route-hi)]"
        >
        {es ? 'Escríbeme' : 'Email me'}
      </a>
      <a
        href="https://github.com/D-Kale"
        aria-label="GitHub de Andrés"
        class="rounded-[var(--radius-s)] border border-[var(--outline)] px-4 py-2 no-underline transition-colors duration-[var(--dur-short)] ease-[var(--ease-emphasized)] hover:bg-[var(--elev-2)] hover:text-[var(--ink)]"
      >
        GitHub
      </a>
    </div>
  </div>
  <div class="mx-auto w-56 md:w-full">
    <div class="overflow-hidden rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-2)]">
      <img
        src={portraitSrc}
        alt={portraitAlt}
        width="800"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full object-cover brightness-[0.88] contrast-[1.04] saturate-[0.92]"
      />
    </div>
  </div>

  <div class="hero-road" aria-hidden="true"></div>
</section>
