---
import { forLocale, projects } from '../data/projects';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const list = forLocale(lang);
const featured = list.filter((p) => p.featured);
const rest = list.filter((p) => !p.featured);
---

<ul class="grid gap-6">
  {
    featured.map((p) => (
      <li class="grid gap-6 rounded-[var(--radius-m)] border border-[var(--ink-soft)] bg-white p-6 shadow-card md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="font-[var(--font-mono)] text-[11px] uppercase tracking-wide text-[var(--jungle)]">
            {p.kind} · {p.year}
          </p>
          <h3 class="mt-1 text-2xl font-bold">{p.title}</h3>
          <p class="mt-3 max-w-prose">{p.summary}</p>
          <ul class="mt-4 list-disc pl-5 text-sm text-[var(--ink)]/85">
            {p.depth.map((d) => <li>{d}</li>)}
          </ul>
          {p.links?.length && (
            <p class="mt-4">
              {p.links.map((l) => <a class="text-sm underline hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
            </p>
          )}
        </div>
        <ul class="flex flex-wrap content-start gap-2">
          {p.stack.map((s) => (
            <li class="rounded-full bg-[var(--paper-deep)] px-3 py-1 font-[var(--font-mono)] text-[11px]">{s}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<ul class="mt-6 grid gap-4 md:grid-cols-2">
  {
    rest.map((p) => (
      <li class="rounded-[var(--radius-m)] border border-[var(--ink-soft)] bg-white p-5 shadow-card">
        <p class="font-[var(--font-mono)] text-[11px] uppercase tracking-wide text-[var(--jungle)]">
          {p.kind} · {p.year}
        </p>
        <h3 class="mt-1 text-lg font-bold">{p.title}</h3>
        <p class="mt-2 text-sm">{p.summary}</p>
        {p.depth.length > 0 && (
          <ul class="mt-3 list-disc pl-5 text-xs text-[var(--ink)]/80">
            {p.depth.map((d) => <li>{d}</li>)}
          </ul>
        )}
        {p.links?.length && (
          <p class="mt-3">
            {p.links.map((l) => <a class="text-xs underline hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
          </p>
        )}
      </li>
    ))
  }
</ul>
