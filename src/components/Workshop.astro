---
import { forLocale } from '../data/projects';
import TechChip from './TechChip.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const list = forLocale(lang);
const featured = list.filter((p) => p.featured);
const rest = list.filter((p) => !p.featured);
const es = lang === 'es';
const techLabel = es ? 'Tecnologías' : 'Technologies';
const depthLabel = es ? 'Qué hay debajo' : 'What is underneath';
---

<ul class="grid gap-6">
  {
    featured.map((p) => (
      <li class="overflow-hidden rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] transition-colors duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:bg-[var(--elev-2)]">
        {p.image &&
          (p.imageFit === 'logo' ? (
            <div class="flex items-center justify-center border-b border-[var(--outline-variant)] bg-[var(--elev-2)] px-8 py-16">
              <img
                class="h-48 w-auto"
                src={p.image}
                alt={p.alt ?? ''}
                width={p.imageWidth ?? 400}
                height={p.imageHeight ?? 400}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <img
              class="aspect-[16/9] w-full object-cover"
              src={p.image}
              alt={p.alt ?? ''}
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
            />
          ))}
        <div class="grid gap-6 p-6 md:grid-cols-[1.4fr_1fr]">
          <div>
            <p class="font-[var(--font-mono)] text-[12px] tracking-wide text-[var(--ink-soft)]">{p.year}</p>
            <h3 class="mt-1 text-2xl font-bold">{p.title}</h3>
            <p class="mt-1 text-sm text-[var(--ink-soft)]">{p.kind}</p>
            <p class="mt-3 max-w-prose">{p.summary}</p>
            {p.depth.length > 0 && (
              <details class="mt-4">
                <summary>{depthLabel}</summary>
                <ul class="mt-3 list-disc pl-5 text-sm text-[var(--ink)]/85">
                  {p.depth.map((d) => <li>{d}</li>)}
                </ul>
              </details>
            )}
            {p.links.length > 0 && (
              <p class="mt-4 flex flex-wrap gap-x-4">
                {p.links.map((l) => <a class="inline-flex min-h-6 items-center text-sm underline hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
              </p>
            )}
          </div>
          <ul class="flex flex-wrap content-start gap-2" aria-label={techLabel}>
            {p.stack.map((s) => <TechChip name={s} />)}
          </ul>
        </div>
        {p.gallery.length > 0 && (
          <ul class="grid gap-px border-t border-[var(--outline-variant)] bg-[var(--outline-variant)] sm:grid-cols-3">
            {p.gallery.map((g) => (
              <li class="bg-[var(--elev-1)]">
                <img
                  class="aspect-[4/3] w-full object-cover"
                  src={g.src}
                  alt={g.alt[lang]}
                  width="1400"
                  height="1400"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<ul class="mt-6 grid gap-4 md:grid-cols-2">
  {
    rest.map((p) => (
      <li class="rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] p-5 transition-colors duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:bg-[var(--elev-2)]">
        <p class="font-[var(--font-mono)] text-[12px] tracking-wide text-[var(--ink-soft)]">{p.year}</p>
        <h3 class="mt-1 text-lg font-bold">{p.title}</h3>
        <p class="mt-1 text-sm text-[var(--ink-soft)]">{p.kind}</p>
        <p class="mt-2 text-sm">{p.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label={techLabel}>
          {p.stack.map((s) => <TechChip name={s} />)}
        </ul>
        {p.depth.length > 0 && (
          <details class="mt-3">
            <summary>{depthLabel}</summary>
            <ul class="mt-2 list-disc pl-5 text-xs text-[var(--ink)]/80">
              {p.depth.map((d) => <li>{d}</li>)}
            </ul>
          </details>
        )}
        {p.links.length > 0 && (
          <p class="mt-3 flex flex-wrap gap-x-4">
            {p.links.map((l) => <a class="inline-flex min-h-6 items-center text-xs underline hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
          </p>
        )}
      </li>
    ))
  }
</ul>
