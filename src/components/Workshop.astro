---
import { forLocale } from '../data/projects';
import TechChip from './TechChip.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const list = forLocale(lang);
const featured = list.filter((p) => p.featured);
const rest = list.filter((p) => !p.featured);
const es = lang === 'es';
const techLabel = es ? 'Tecnologías' : 'Technologies';
const depthLabel = es ? 'Qué hay debajo' : 'What is underneath';
const moreLabel = es ? 'Más proyectos' : 'More projects';
---

<ul class="grid gap-8">
  {
    featured.map((p, i) => (
      <li
        class="reveal group overflow-hidden rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] transition-[border-color,background-color] duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:border-[var(--outline)] hover:bg-[var(--elev-2)]"
        style={`--i:${i}`}
      >
        <span class="block h-1 w-full bg-[var(--route)]" aria-hidden="true"></span>
        {p.image &&
          (p.imageFit === 'logo' ? (
            <div class="flex items-center justify-center border-b border-[var(--outline-variant)] bg-[var(--elev-2)] px-8 py-14">
              <img
                class="h-40 w-auto transition-transform duration-[var(--dur-long)] ease-[var(--ease-standard)] group-hover:scale-[1.04]"
                src={p.image}
                alt={p.alt ?? ''}
                width={p.imageWidth ?? 400}
                height={p.imageHeight ?? 400}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <img
              class="aspect-[16/9] w-full object-cover transition-transform duration-[var(--dur-long)] ease-[var(--ease-standard)] group-hover:scale-[1.03]"
              src={p.image}
              alt={p.alt ?? ''}
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
            />
          ))}
        <div class="grid gap-8 p-7 md:grid-cols-[1.45fr_1fr] md:p-9">
          <div>
            <p class="font-[var(--font-mono)] text-[12px] tracking-wide text-[var(--ink-soft)]">{p.year}</p>
            <h3 class="mt-2 text-2xl font-bold md:text-3xl">{p.title}</h3>
            <p class="mt-2 text-sm text-[var(--ink-soft)]">{p.kind}</p>
            <p class="mt-5 max-w-prose leading-relaxed">{p.summary}</p>
            {p.depth.length > 0 && (
              <details class="mt-6">
                <summary>{depthLabel}</summary>
                <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-[var(--ink)]/85">
                  {p.depth.map((d) => <li>{d}</li>)}
                </ul>
              </details>
            )}
            {p.links.length > 0 && (
              <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
                {p.links.map((l) => <a class="inline-flex min-h-8 items-center text-sm underline underline-offset-4 hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
              </p>
            )}
          </div>
          <ul class="flex flex-wrap content-start gap-2" aria-label={techLabel}>
            {p.stack.map((s) => <TechChip name={s} />)}
          </ul>
        </div>
        {p.gallery.length > 0 && (
          <ul class="grid gap-px border-t border-[var(--outline-variant)] bg-[var(--outline-variant)] sm:grid-cols-3">
            {p.gallery.map((g) => (
              <li class="bg-[var(--elev-1)]">
                <img
                  class="aspect-[4/3] w-full object-cover transition-transform duration-[var(--dur-long)] ease-[var(--ease-standard)] group-hover:scale-[1.04]"
                  src={g.src}
                  alt={g.alt[lang]}
                  width="1400"
                  height="1400"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<h3 class="mt-14 text-xl font-bold md:text-2xl">{moreLabel}</h3>

<ul class="mt-6 grid gap-6 md:grid-cols-2">
  {
    rest.map((p, i) => (
      <li
        class="reveal rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] p-6 transition-[border-color,background-color,transform] duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:-translate-y-0.5 hover:border-[var(--outline)] hover:bg-[var(--elev-2)]"
        style={`--i:${i}`}
      >
        <p class="font-[var(--font-mono)] text-[12px] tracking-wide text-[var(--ink-soft)]">{p.year}</p>
        <h4 class="mt-2 text-lg font-bold">{p.title}</h4>
        <p class="mt-1 text-sm text-[var(--ink-soft)]">{p.kind}</p>
        <p class="mt-3 text-sm leading-relaxed">{p.summary}</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={techLabel}>
          {p.stack.map((s) => <TechChip name={s} />)}
        </ul>
        {p.depth.length > 0 && (
          <details class="mt-4">
            <summary>{depthLabel}</summary>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--ink)]/80">
              {p.depth.map((d) => <li>{d}</li>)}
            </ul>
          </details>
        )}
        {p.links.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1">
            {p.links.map((l) => <a class="inline-flex min-h-8 items-center text-sm underline underline-offset-4 hover:text-[var(--route)]" href={l.href} rel="noopener">{l.label}</a>)}
          </p>
        )}
      </li>
    ))
  }
</ul>
