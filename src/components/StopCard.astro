---
interface Props {
  id: string;
  kind: 'parada' | 'mirador';
  place: string;
  title: string;
  body: string;
  lang?: 'es' | 'en';
}

const { id, kind, place, title, body, lang = 'es' } = Astro.props;
const es = lang === 'es';
const kindLabel = kind === 'parada' ? (es ? 'Parada técnica' : 'Technical stop') : es ? 'Mirador humano' : 'Human lookout';
const accent = kind === 'parada' ? 'var(--route)' : 'var(--jungle)';
---

<article id={id} class="rounded-[var(--radius-m)] border border-[var(--ink-soft)] bg-white p-6 shadow-card">
  <p class="font-[var(--font-mono)] text-[11px] uppercase tracking-wide" style={`color:${accent}`}>
    {kindLabel} · {place}
  </p>
  <h3 class="mt-2 text-xl font-bold">{title}</h3>
  <p class="mt-2 text-sm text-[var(--ink)]/85">{body}</p>
</article>
