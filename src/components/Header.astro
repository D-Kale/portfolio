---
import { ui_for, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui_for(lang);
const other: Locale = lang === 'es' ? 'en' : 'es';
const links = [
  { href: `${localePath[lang]}#ruta`, label: lang === 'es' ? 'ruta' : 'route' },
  { href: `${localePath[lang]}#taller`, label: lang === 'es' ? 'taller' : 'work' },
  { href: `${localePath[lang]}#comunidad`, label: lang === 'es' ? 'comunidad' : 'community' },
  { href: `${localePath[lang]}#cajuela`, label: lang === 'es' ? 'cajuela' : 'trunk' },
];
---

<header class="border-b border-[var(--ink-soft)]/40">
  <nav aria-label={lang === 'es' ? 'principal' : 'main'} class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
    <a href={localePath[lang]} class="inline-flex min-h-8 items-center text-lg font-bold text-[var(--ink)] no-underline">Andrés Sánchez</a>
    <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 sm:gap-x-3">
      {
        links.map((l) => (
          <li>
            <a
              class="inline-flex min-h-8 items-center rounded-[var(--radius-s)] px-2 text-sm text-[var(--ink)] no-underline hover:bg-[var(--surface-hover)] hover:text-[var(--route)]"
              href={l.href}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={localePath[other]}
          hreflang={other}
          aria-label={lang === 'es' ? 'Cambiar a inglés' : 'Switch to Spanish'}
          class="inline-flex min-h-8 items-center rounded border border-[var(--ink-soft)] px-2 font-[var(--font-mono)] text-xs text-[var(--ink)] no-underline hover:bg-[var(--surface-hover)]"
        >
          {t['lang.toggle']}
        </a>
      </li>
    </ul>
  </nav>
</header>
