---
import { localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const other: Locale = lang === 'es' ? 'en' : 'es';
const links = [
  { href: `${localePath[lang]}#ruta`, label: lang === 'es' ? 'ruta' : 'route' },
  { href: `${localePath[lang]}#taller`, label: lang === 'es' ? 'taller' : 'workshop' },
  { href: `${localePath[lang]}#comunidad`, label: lang === 'es' ? 'comunidad' : 'community' },
  { href: `${localePath[lang]}#formacion`, label: lang === 'es' ? 'formación' : 'education' },
  { href: `${localePath[lang]}#contacto`, label: lang === 'es' ? 'contacto' : 'contact' },
];
const navLabel = lang === 'es' ? 'principal' : 'main';
---

<header data-site-header class="sticky top-0 z-50 border-b border-[var(--outline-variant)] bg-[var(--bg)]">
  <div class="mx-auto flex h-[var(--header-h)] max-w-5xl items-center justify-between gap-4 px-4">
    <a href={localePath[lang]} class="inline-flex items-baseline gap-2 no-underline">
      <span class="text-base font-bold tracking-tight text-[var(--ink)]">Andrés Sánchez</span>
      <span class="hidden font-[var(--font-mono)] text-[11px] uppercase tracking-[0.16em] text-[var(--ink-soft)] sm:inline"
        >León, Nicaragua</span
      >
    </a>

    <nav aria-label={navLabel} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a
                class="inline-flex min-h-9 items-center rounded-[var(--radius-s)] px-3 font-[var(--font-mono)] text-[12px] uppercase tracking-[0.1em] text-[var(--ink-soft)] no-underline transition-colors duration-[var(--dur-short)] ease-[var(--ease-standard)] hover:bg-[var(--surface-hover)] hover:text-[var(--ink)]"
                href={l.href}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        aria-label={lang === 'es' ? 'Cambiar entre tema claro y oscuro' : 'Switch between light and dark theme'}
        class="inline-grid h-9 w-9 place-items-center rounded-[var(--radius-s)] border border-[var(--outline-variant)] text-[var(--ink-soft)] transition-colors duration-[var(--dur-short)] hover:border-[var(--outline)] hover:text-[var(--ink)]"
      >
        <svg class="icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>

      <a
        href={localePath[other]}
        hreflang={other}
        aria-label={lang === 'es' ? 'Cambiar a inglés' : 'Switch to Spanish'}
        class="inline-grid h-9 min-w-9 place-items-center rounded-[var(--radius-s)] border border-[var(--outline-variant)] px-2 font-[var(--font-mono)] text-[12px] text-[var(--ink-soft)] no-underline transition-colors duration-[var(--dur-short)] hover:border-[var(--outline)] hover:text-[var(--ink)]"
      >
        {other.toUpperCase()}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        data-label-open={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        data-label-close={lang === 'es' ? 'Cerrar menú' : 'Close menu'}
        aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        class="inline-grid h-9 w-9 place-items-center rounded-[var(--radius-s)] border border-[var(--outline-variant)] text-[var(--ink-soft)] transition-colors duration-[var(--dur-short)] hover:border-[var(--outline)] hover:text-[var(--ink)] md:hidden"
      >
        <svg class="icon-menu h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label={navLabel}
    data-menu
    class="border-t border-[var(--outline-variant)] bg-[var(--bg)] shadow-[var(--shadow-float)] md:hidden"
    hidden
  >
    <ul class="mx-auto max-w-5xl px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a
              class="flex min-h-11 items-center border-b border-[var(--outline-variant)] font-[var(--font-mono)] text-[13px] uppercase tracking-[0.1em] text-[var(--ink-soft)] no-underline last:border-b-0 hover:text-[var(--route)]"
              href={l.href}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="h-[2px] bg-[var(--outline-variant)]" aria-hidden="true">
    <div data-progress class="h-full origin-left scale-x-0 bg-[var(--route)]"></div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-menu]');

    const setMenu = (open: boolean) => {
      if (!menuToggle || !menu) return;
      menuToggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      const label = open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen;
      if (label) menuToggle.setAttribute('aria-label', label);
    };

    menuToggle?.addEventListener('click', () => {
      setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    menu?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
      setMenu(false);
      menuToggle.focus();
    });

    const themeButton = header.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    themeButton?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('tema', next);
      } catch {
        /* sin persistencia: el tema solo vive en esta sesion */
      }
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'light' ? '#ffffff' : '#0b0c10');
    });

    const bar = header.querySelector<HTMLElement>('[data-progress]');
    const onScroll = () => {
      if (!bar) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? window.scrollY / max : 0;
      bar.style.transform = `scaleX(${progress})`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
