---
import { postcards, stampLabel } from '../data/postcards';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
---

<section
  id="cajuela"
  class="mt-[var(--space-xl)]"
  aria-labelledby="cajuela-title"
>
  <h2 id="cajuela-title" class="text-3xl font-bold">{lang === 'es' ? 'La Cajuela' : 'The trunk'}</h2>
  <p class="mt-2 max-w-prose text-sm text-[var(--ink)]/80">
    {lang === 'es' ? 'Postales dejadas por mentores y compañeros a lo largo de la ruta.' : 'Postcards left by mentors and peers along the route.'}
  </p>
  <ul class="mt-6 grid gap-4 md:grid-cols-3">
    {
      postcards.map((p) => (
        <li class="rounded-[var(--radius-m)] border border-[var(--route)]/30 bg-[var(--elev-1)] p-5 transition-colors duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:bg-[var(--elev-2)]">
          <p class="font-[var(--font-mono)] text-[12px] tracking-wide text-[var(--sky)]">
            {stampLabel(lang, p.stamp)} · {p.role[lang]}
          </p>
          <blockquote class="mt-2 border-l border-[var(--route)] pl-3 italic">{p.text[lang]}</blockquote>
          <p class="mt-3 text-xs font-bold">{p.author}</p>
        </li>
      ))
    }
  </ul>
</section>
