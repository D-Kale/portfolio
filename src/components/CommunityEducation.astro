---
import { community, formation, pick } from '../data/community';
import BrandMark from './BrandMark.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const highlight = formation.filter((f) => f.image);
const rest = formation.filter((f) => !f.image);
---

<section
  id="comunidad"
  class="mt-[var(--space-xl)]"
  aria-labelledby="comunidad-title"
>
  <h2 id="comunidad-title" class="text-3xl font-bold">{es ? 'Comunidad' : 'Community'}</h2>
  <ul class="mt-6 grid gap-4 md:grid-cols-2">
    {
      community.map((c, i) => (
        <li
          class="reveal overflow-hidden rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] transition-colors duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:bg-[var(--elev-2)]"
          style={`--i:${i}`}
        >
          {c.image && (
            <img
              class="aspect-[16/9] w-full object-cover"
              src={c.image}
              alt={c.alt?.[lang] ?? ''}
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="p-5">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              {c.brand && <BrandMark name={c.brand} />}
              {c.logo && (
                <span class="brand-plate">
                  <img class="h-6 w-auto" src={c.logo} alt={c.logoAlt?.[lang] ?? ''} width="600" height="207" loading="lazy" decoding="async" />
                </span>
              )}
              {c.title[lang]}
            </h3>
            <p class="mt-2 text-sm">{c.summary[lang]}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section id="formacion" class="mt-[var(--space-xl)]" aria-labelledby="formacion-title">
  <h2 id="formacion-title" class="text-3xl font-bold">{es ? 'Formación' : 'Education'}</h2>
  <p class="mt-2 max-w-prose text-[var(--ink-soft)]">
    {
      es
        ? 'La base que sostiene el trabajo: hardware y sistemas en ULSA, fundamentos web de CS50, redes de Cisco, emprendimiento de Aspire e inglés técnico.'
        : 'The base that holds the work up: hardware and systems at ULSA, web fundamentals from CS50, networking from Cisco, entrepreneurship from Aspire and technical English.'
    }
  </p>

  <ul class="mt-6 grid gap-4">
    {
      highlight.map((f) => (
        <li class="reveal overflow-hidden rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)]">
          <div class="grid md:grid-cols-[1.1fr_1fr]">
            <img
              class="aspect-[16/9] w-full object-cover"
              src={f.image}
              alt={f.alt?.[lang] ?? ''}
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
            />
            <div class="p-6 md:p-8">
              {f.logo && (
                <span class="brand-plate mb-5 inline-block">
                  <img
                    class="h-9 w-auto"
                    src={f.logo}
                    alt={f.logoAlt?.[lang] ?? ''}
                    width="1200"
                    height="263"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <h3 class="text-xl font-bold md:text-2xl">{f.title[lang]}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--ink-soft)]">{f.summary[lang]}</p>
              {f.status && (
                <span class="mt-5 inline-block rounded-full border border-[var(--outline-variant)] bg-[var(--elev-2)] px-3 py-1 font-[var(--font-mono)] text-[12px] text-[var(--ink-soft)]">
                  {pick(lang, f.status)}
                </span>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <ul class="mt-6 grid gap-6 md:grid-cols-2">
    {
      rest.map((f, i) => (
        <li
          class="reveal flex flex-col rounded-[var(--radius-m)] border border-[var(--outline-variant)] bg-[var(--elev-1)] p-6 transition-colors duration-[var(--dur-medium)] ease-[var(--ease-standard)] hover:bg-[var(--elev-2)]"
          style={`--i:${i}`}
        >
          <div class="flex items-start justify-between gap-4">
            {(f.brand || f.logo) && (
              <span class="min-h-8">
                {f.brand && <BrandMark name={f.brand} />}
                {f.logo && (
                  <span class="brand-plate">
                    <img class="h-8 w-auto" src={f.logo} alt={f.logoAlt?.[lang] ?? ''} width="600" height="207" loading="lazy" decoding="async" />
                  </span>
                )}
              </span>
            )}
            {f.status && (
              <span
                class={`shrink-0 rounded-full border px-3 py-1 font-[var(--font-mono)] text-[12px] ${
                  pick(lang, f.status).toLowerCase().includes('complet')
                    ? 'border-[var(--jungle)] text-[var(--jungle)]'
                    : 'border-[var(--route)] text-[var(--route)]'
                }`}
              >
                {pick(lang, f.status)}
              </span>
            )}
          </div>
          <h3 class="mt-5 text-lg font-bold">{f.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--ink-soft)]">{f.summary[lang]}</p>
        </li>
      ))
    }
  </ul>
</section>
